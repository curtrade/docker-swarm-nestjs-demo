# Пример переменных окружения для локальной разработки.
# Скопируй в .env (он в .gitignore) и поправь под себя.

PORT=3000
APP_VERSION=dev

# Redis
REDIS_URL=redis://localhost:6379

# Postgres (Prisma). В главе 08 пароль идёт прямо в URL — это анти-паттерн,
# который мы исправим в главе 09 через docker secret.
DATABASE_URL=postgresql://app:app_password@localhost:5432/appdb?schema=public
